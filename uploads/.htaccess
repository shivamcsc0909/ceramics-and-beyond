# Prevent script execution in uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Deny access to dangerous executable extensions
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|cgi|pl|py|sh|bash|exe|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Only permit images
<FilesMatch "(?i)\.(jpe?g|png|gif|webp|avif|svg)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

Options -ExecCGI -Indexes
Header set X-Content-Type-Options "nosniff"
